{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tos.app.contracts.approval_envelope.v0",
  "title": "ApprovalEnvelope",
  "description": "Generalizes ratification_payload.v0 (which stays for L4 replay per evolution rule 3) to ALL signature nodes #1-#8. SE signs bytes not screens, so visible_card_hash binds what-the-user-saw into the signed payload — a screen that was never shown cannot produce a valid hash. Tier-2 hostile-host slots are RESERVED fields (v0.x writes them as null/T0-T2, per the approved execution ruling — no hardware implementation now). host_threat_level T3 requires external_anchor_id to be present before any irreversible action class proceeds.",
  "type": "object",
  "required": [
    "schema_version",
    "envelope_id",
    "signature_node",
    "action_class",
    "actor",
    "project_id",
    "spec_hash",
    "budget_hash",
    "policy_hash",
    "payload_hash",
    "visible_card_hash",
    "human_readable_summary",
    "consequence_statement",
    "reversibility",
    "target_resource_hash",
    "expiry_utc",
    "nonce",
    "prev_tape_head",
    "required_signature_level",
    "host_threat_level"
  ],
  "properties": {
    "schema_version": { "const": "tos.app.approval_envelope.v0" },
    "envelope_id": { "type": "string" },
    "signature_node": { "enum": [1, 2, 3, 4, 5, 6, 7, 8] },
    "action_class": { "enum": [0, 1, 2, 3, 4] },
    "actor": { "type": "string" },
    "project_id": { "type": "string" },
    "spec_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{8,64}$" },
    "budget_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{8,64}$" },
    "policy_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{8,64}$" },
    "payload_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{8,64}$" },
    "visible_card_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{8,64}$" },
    "human_readable_summary": { "type": "string" },
    "consequence_statement": { "type": "string" },
    "reversibility": { "enum": ["reversible", "draft", "irreversible"] },
    "target_resource_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{8,64}$" },
    "expiry_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "nonce": { "type": "string" },
    "prev_tape_head": { "type": "string", "pattern": "^sha256:[0-9a-f]{8,64}$" },
    "required_signature_level": { "enum": ["app_approval", "touch_id_se", "external_anchor"] },
    "host_threat_level": { "enum": ["T0", "T1", "T2", "T3"] },
    "external_anchor_id": { "type": "string" },
    "audit_root": { "type": "string" }
  }
}
