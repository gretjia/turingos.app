{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tos.app.contracts.tape_node.v0",
  "title": "TapeNode",
  "description": "Shell-side contract for tape entries consumed/produced via runtime interfaces; canonical ChainTape semantics live upstream in the runtime repo per docs/UPSTREAM_CONTRACT.md — this is NOT a reimplementation. The shell reads these nodes from the runtime and writes back only via declared CLI/lib interfaces (UPSTREAM_CONTRACT.md rule 2). hash fields are sha256-prefixed hex; prev_node_hash on genesis nodes may be the zero hash.",
  "type": "object",
  "required": [
    "schema_version",
    "node_id",
    "kind",
    "utc",
    "author",
    "payload_hash",
    "prev_node_hash",
    "node_hash",
    "verified"
  ],
  "properties": {
    "schema_version": { "const": "tos.app.tape_node.v0" },
    "node_id": { "type": "string" },
    "kind": {
      "enum": [
        "genesis",
        "spec_ratified",
        "budget_ratified",
        "credential_scope_ratified",
        "work_order",
        "agent_proposal",
        "action_request",
        "action_receipt",
        "approval_envelope",
        "approval_signature",
        "rejection",
        "failure",
        "model_call",
        "tool_install",
        "tool_update",
        "tool_remove",
        "skill_activation",
        "ci_evidence",
        "predicate_verdict",
        "merge_dossier",
        "head_anchor",
        "budget_settlement",
        "gc_receipt",
        "rule_broadcast",
        "halt"
      ]
    },
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "author": { "type": "string" },
    "payload_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{8,64}$" },
    "prev_node_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{8,64}$" },
    "node_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{8,64}$" },
    "verified": { "type": "boolean" },
    "reject_class": { "type": "string" },
    "project_id": { "type": "string" },
    "work_order_id": { "type": "string" },
    "payload": { "type": "object" }
  }
}
